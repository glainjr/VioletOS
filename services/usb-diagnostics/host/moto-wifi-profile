#!/usr/bin/env python3
"""Provision one WPA2-Personal profile over VioletOS USB, for this boot only.

    moto-wifi-profile            ask for the network name and password
    moto-wifi-profile --save     the same, and keep the profile on this Mac
    moto-wifi-profile --saved    provision the kept profile without asking

--save keeps the network name and the derived WPA2 key (not the password) in
~/.config/violetos/wifi-profile.json, readable only by you. moto-flash
provisions it after every flash. Delete the file to forget the network.

Environment variables answer the questions and set two optional join settings.
Both settings are off unless set, last for this boot like the profile, and are
kept by --save:

    VIOLET_SSID, VIOLET_WIFIPASS   the network name and password
    VIOLET_FIXED_MAC               the phone's Wi-Fi address, such as 02:11:22:33:44:55,
                                   in place of a random one for each radio session
    VIOLET_HOSTNAME                the name the phone gives the network with DHCP

A fixed address and a name let every network the phone joins know it again,
which RFC 7844 advises a private client against. VIOLET_IS_PRIVATE_CLIENT (1,
yes, true, on or enable) overrides both, set here or kept with the profile:
the phone joins under a random address and gives no name.
"""
import argparse
import getpass
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import time
import warnings
from pathlib import Path

SAVED = Path.home() / ".config/violetos/wifi-profile.json"


def provision(ssid, pmk):
    nonce = (secrets.randbelow(0xffffffff) + 1).to_bytes(4, "little")
    record = nonce + bytes([len(ssid)]) + ssid.ljust(32, b"\0") + pmk + int(time.time()).to_bytes(4, "little")
    tool = Path(__file__).resolve().parents[3] / "build/moto-package"
    subprocess.run([tool, "provision-wpa2"], input=record, check=True)


def truthy(name):
    """An on/off environment variable. Unset or empty is off."""
    value = os.environ.get(name, "").strip().lower()
    if value in ("1", "yes", "true", "on", "enable", "enabled"):
        return True
    if value in ("", "0", "no", "false", "off", "disable", "disabled"):
        return False
    raise SystemExit(f"{name} must be 1, yes, true, on or enable, or 0, no, false, off or disable")


def join_options():
    """VIOLET_FIXED_MAC and VIOLET_HOSTNAME, checked; unset or empty leaves a setting off."""
    mac, hostname = os.environ.get("VIOLET_FIXED_MAC", ""), os.environ.get("VIOLET_HOSTNAME", "")
    if mac:
        if not re.fullmatch(r"[0-9A-Fa-f]{2}([:-][0-9A-Fa-f]{2}){5}", mac):
            raise SystemExit("VIOLET_FIXED_MAC must look like 02:11:22:33:44:55")
        mac = ":".join(re.split("[:-]", mac.lower()))
        if int(mac[:2], 16) & 1 or mac == "00:00:00:00:00:00":
            raise SystemExit("VIOLET_FIXED_MAC must be a unicast address: an even first byte, such as 02")
    if hostname and not re.fullmatch(r"[A-Za-z0-9]([A-Za-z0-9-]{0,30}[A-Za-z0-9])?", hostname):
        raise SystemExit("VIOLET_HOSTNAME must be 1–32 letters, digits or hyphens, with no hyphen at either end")
    return mac, hostname


def provision_options(mac, hostname, private):
    tool = Path(__file__).resolve().parents[3] / "build/moto-package"
    if private:
        # Zero and empty also clear an address and a name set earlier in this boot.
        if subprocess.run([tool, "join-options"], input=bytes(6)).returncode:
            raise SystemExit("The handset did not confirm that it holds no fixed address or host name "
                             "(an older VioletOS image has neither)")
        print("Private client: a random address for each radio session and no host name.")
        return
    if not mac and not hostname:
        return
    record = bytes.fromhex(mac.replace(":", "") or "00" * 6) + hostname.encode("ascii")
    if subprocess.run([tool, "join-options"], input=record).returncode:
        raise SystemExit("The handset did not accept the fixed address and host name (an older VioletOS image?)")
    set_ = " and ".join(filter(None, [mac and f"fixed address {mac}", hostname and f"host name {hostname}"]))
    print(set_[0].upper() + set_[1:] + " set for this boot.")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--save", action="store_true", help="keep the profile on this Mac")
    parser.add_argument("--saved", action="store_true", help="provision the kept profile")
    args = parser.parse_args()
    private = truthy("VIOLET_IS_PRIVATE_CLIENT")
    if args.saved:
        if not SAVED.exists():
            raise SystemExit(f"No saved Wi-Fi profile ({SAVED}); run moto-wifi-profile --save once")
        saved = json.loads(SAVED.read_text())
        provision(saved["ssid"].encode("utf-8"), bytes.fromhex(saved["pmk"]))
        print(f"Saved profile for {saved['ssid']} provisioned for this boot.")
        provision_options(saved.get("mac", ""), saved.get("hostname", ""), private)
        return
    if not sys.stdin.isatty():
        raise SystemExit("Run from an interactive terminal to enter a Wi-Fi passphrase privately")
    warnings.simplefilter("error", getpass.GetPassWarning)
    mac, hostname = ("", "") if private else join_options()

    sys.stderr.write("Automate wifi setup - shell source a file that contains VIOLET_SSID=<ssid> VIOLET_WIFIPASS=<password> to automate wifi setup\n")

    # SSID
    ssid = (os.environ.get("VIOLET_SSID") or input("Wi-Fi network name: ")).encode("utf-8")
    if not 1 <= len(ssid) <= 32:
        raise SystemExit("VIOLET_SSID must be 1–32 bytes")

    # WIFI PASS
    password = (os.environ.get("VIOLET_WIFIPASS") or getpass.getpass("Wi-Fi password: ")).encode("ascii")
    if not 8 <= len(password) <= 63 or not all(32 <= b <= 126 for b in password):
        raise SystemExit("Use an 8–63 character WPA2 passphrase")

    pmk = hashlib.pbkdf2_hmac("sha1", password, ssid, 4096, 32)
    provision(ssid, pmk)
    print("Profile provisioned for this boot.")
    provision_options(mac, hostname, private)
    if args.save:
        SAVED.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(SAVED, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"ssid": ssid.decode("utf-8"), "pmk": pmk.hex(),
                       **({"mac": mac} if mac else {}), **({"hostname": hostname} if hostname else {})}, f)
        os.chmod(SAVED, 0o600)
        print(f"Saved for later flashes in {SAVED} (name and derived key, readable only by you).")


if __name__ == "__main__":
    main()
