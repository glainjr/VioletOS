# Wi-Fi settings for services/usb-diagnostics/host/moto-wifi-profile.
#
# Copy this file to secrets/wifi.rc (git ignores secrets/), fill it in, then:
#
#     source secrets/wifi.rc
#     services/usb-diagnostics/host/moto-wifi-profile --save
#
# Keep the "export": without it the script does not see the variable.
# The script asks for whichever one is left empty.

# The network's name, 1 to 32 bytes. For example: export VIOLET_SSID='Home Wi-Fi'
export VIOLET_SSID=''

# Its WPA2 password, 8 to 63 printable ASCII characters.
export VIOLET_WIFIPASS=''
